# Primo MCP Server Configuration
# All values have University of Alberta defaults -- only override if connecting to a different institution.
# See "Finding the values for your institution" in README.md.

# PRIMO_BASE_URL=https://search.library.ualberta.ca/primaws/rest/pub
# PRIMO_VID=01UOA_INST:UOA
# PRIMO_INSTITUTION_NAME=University of Alberta
# PRIMO_TAB_EVERYTHING=Everything
# PRIMO_TAB_CATALOGUE=LibraryCatalog
# PRIMO_SCOPE_COMBINED=MyInst_and_CI
# PRIMO_SCOPE_LOCAL=MyInstitution
# PRIMO_REQUEST_TIMEOUT=30.0
# PRIMO_MAX_RESULTS_PER_REQUEST=50
# PRIMO_DEFAULT_RESULTS=10
# PRIMO_LANGUAGE=en
